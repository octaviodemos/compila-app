{
  "expo": {
    "name": "compila-app",
    "slug": "compila-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "compilaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.compila.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0F14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0F0F14"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7C3AED",
          "iosDisplayInForeground": true
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Streak",
              "label": "Compila — Sequência",
              "description": "Mostra sua sequência de dias resolvendo desafios",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetWidth": "150dp",
              "targetHeight": "150dp",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "targetSdkVersion": 34
            }
          ]
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40a983ff-da39-44ef-98e5-1413b1e9f25b"
      }
    }
  }
}
